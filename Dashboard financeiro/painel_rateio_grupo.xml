  <auditoria>
    <query><![CDATA[
EVALUATE
VAR _B = FILTER('lancamentos', TRIM('lancamentos'[DRE]) = "Rateio do Grupo")
VAR _P = ADDCOLUMNS(_B, "@E", TRIM('lancamentos'[EMPRESA]), "@K", VALUE(RIGHT('lancamentos'[PERIODO], 4)) * 100 + VALUE(LEFT('lancamentos'[PERIODO], 2)), "@V", 'lancamentos'[VALOR_AJUSTADO])
RETURN GROUPBY(_P, [@E], [@K], "@Valor", SUMX(CURRENTGROUP(), [@V]))
ORDER BY [@K] ASC, [@E] ASC
    ]]></query>
